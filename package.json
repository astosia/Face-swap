    "usesPermissions": [
      "LaunchApps",
      "Location",
      "ReadWatchSettings",
      "WriteWatchSettings",
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "gm3s9tryo4-dsn.algolia.net",
            "7683ow76eq-dsn.algolia.net"
          ]
        }
      }
    ]
